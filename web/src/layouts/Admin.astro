---
import '../styles/global.css';
import '../styles/admin.css';

const { title } = Astro.props as { title?: string };
const { actor } = Astro.locals;

const nav = [
  { href: '/admin', label: 'Overview' },
  { href: '/admin/games', label: 'Games' },
  { href: '/admin/upload', label: 'Upload' },
  { href: '/admin/seasons', label: 'Seasons' },
  { href: '/admin/tools', label: 'Tools' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ` : ''}League admin</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="admin">
    <header class="topbar admin-bar">
      <div class="topbar-inner">
        <a class="brand" href="/admin"><span class="ball">⚙️</span><span>League admin</span></a>
        <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} aria-current={Astro.url.pathname === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <span class="who">
          {actor?.email}
          {actor?.dev && <span class="tag devtag">dev bypass</span>}
        </span>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap" style="padding-top:0">
      <p class="muted" style="font-size:.8rem; border-top:2px solid #efe4d2; padding-top:1rem">
        <a href="/">← Back to the league site</a>
      </p>
    </footer>
    <script>
      // One copy for the whole admin. Confirmation is an enhancement: with JavaScript
      // off the button still submits, and the server still refuses anything unsafe.
      document.querySelectorAll<HTMLButtonElement>('button[data-confirm]').forEach((b) => {
        b.addEventListener('click', (e) => {
          if (!confirm(b.dataset.confirm!)) e.preventDefault();
        });
      });
    </script>
  </body>
</html>

<style>
  .admin-bar { background: var(--ink); }
  .admin-bar .brand, .admin-bar .nav a { color: #fff; }
  .admin-bar .nav a[aria-current='page'] { color: var(--gold); }
  .who { margin-left: auto; color: #fff; font-size: .8rem; opacity: .85; display: flex; align-items: center; gap: .4rem; }
  .devtag { background: var(--dirt); color: #fff; }

  @media (max-width: 560px) {
    /* The identity moves under the nav rather than competing with it for the
       same row, and the nav gets the full width so five items wrap evenly. */
    .admin-bar .nav { width: 100%; margin-left: 0; }
    .who {
      margin-left: 0;
      width: 100%;
      font-size: .72rem;
      justify-content: flex-start;
      padding-top: .15rem;
      border-top: 1px solid rgba(255,255,255,.15);
    }
  }
</style>
