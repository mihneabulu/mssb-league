---
import Admin from '../../../layouts/Admin.astro';
import Flash from '../../../components/admin/Flash.astro';
import { CHARACTERS, STADIUMS } from '../../../lib/mssb/reference.ts';

const { db } = Astro.locals;
const slug = Astro.params.slug!;

const seasonRows = await db.all(`SELECT * FROM seasons WHERE slug = ?`, [slug]);
const season = seasonRows[0];
if (!season) return Astro.rewrite('/404');
const seasonId = Number(season.id);

const [teams, roster, rounds, games] = await Promise.all([
  db.all(
    `SELECT t.id, t.slug, t.name, t.color, t.stadium_id, t.captain_char_id, t.sort_order,
            (SELECT COUNT(*) FROM roster_slots r WHERE r.team_id = t.id) AS drafted
     FROM teams t WHERE t.season_id = ? ORDER BY t.sort_order, t.id`,
    [seasonId],
  ),
  db.all(`SELECT team_id, char_id FROM roster_slots WHERE season_id = ? ORDER BY char_id`, [seasonId]),
  db.all(`SELECT COUNT(*) AS n FROM rounds WHERE season_id = ?`, [seasonId]),
  db.all(`SELECT COUNT(*) AS n FROM games WHERE season_id = ?`, [seasonId]),
]);

const rosterByTeam = new Map<number, number[]>();
for (const r of roster) {
  const t = Number(r.team_id);
  rosterByTeam.set(t, [...(rosterByTeam.get(t) ?? []), Number(r.char_id)]);
}

const allowDuplicates = Boolean(Number(season.allow_duplicate_chars));

// Named so the checkbox can say what turning it off would cost, and so the draft board
// is not the only place a shared pick is visible.
const charCounts = new Map<number, number>();
for (const r of roster) {
  const c = Number(r.char_id);
  charCounts.set(c, (charCounts.get(c) ?? 0) + 1);
}
const duplicated = [...charCounts.entries()]
  .filter(([, n]) => n > 1)
  .map(([c]) => CHARACTERS[c])
  .sort();

const roundCount = Number(rounds[0]?.n ?? 0);
const gameCount = Number(games[0]?.n ?? 0);
const undrafted = teams.filter((t) => Number(t.drafted) !== 9);
const stadiumEntries = Object.entries(STADIUMS);

// The setup order that actually works: teams, then rosters, then schedule.
const steps = [
  { done: teams.length > 0, label: `${teams.length} teams` },
  { done: teams.length > 0 && undrafted.length === 0, label: 'every roster drafted' },
  { done: roundCount > 0, label: `${roundCount} rounds scheduled` },
];
---
<Admin title={String(season.short_label)}>
  <div class="section-head" style="margin-top:1.4rem">
    <span class="pill">⚙️ {season.short_label}</span>
  </div>
  <Flash />

  <ol class="steps">
    {steps.map((s, i) => (
      <li class={s.done ? 'done' : ''}><span class="n">{s.done ? '✓' : i + 1}</span>{s.label}</li>
    ))}
  </ol>

  <form class="card block" method="post" action={`/api/admin/seasons/${slug}`}>
    <h2>Season details</h2>
    <div class="fields">
      <label class="f grow"><span class="lbl">Name (page titles)</span>
        <input name="name" value={String(season.name)} required /></label>
      <label class="f"><span class="lbl">Short label (homepage)</span>
        <input name="shortLabel" value={String(season.short_label)} required /></label>
      <label class="f"><span class="lbl">First day</span>
        <input name="startDate" type="date" value={String(season.start_date)} required /></label>
      <label class="f"><span class="lbl">Rounds</span>
        <input name="rounds" type="number" min="0" value={String(season.rounds)} /></label>
      <label class="f"><span class="lbl">Status</span>
        <select name="status">
          {['draft', 'active', 'complete', 'archived'].map((v) => (
            <option value={v} selected={String(season.status) === v}>{v}</option>
          ))}
        </select>
      </label>
    </div>
    <label class="check">
      <input type="checkbox" name="allowDuplicateChars" checked={allowDuplicates} />
      <span>
        <strong>Let teams draft the same character</strong>
        <span class="muted">
          Off, a character belongs to one team all season. On, any team can pick anyone, and
          each team gets its own stat line for them — two Marios, two sets of numbers.
          {duplicated.length > 0 && ` Currently shared: ${duplicated.join(', ')}.`}
        </span>
      </span>
    </label>
    <div class="row">
      <button class="btn" type="submit">Save details</button>
      {Number(season.is_current) !== 1 && (
        <button class="btn ghost" type="submit" name="_action" value="make-current">Make this the current season</button>
      )}
      {gameCount === 0 && (
        <button class="btn danger" type="submit" name="_action" value="delete"
                data-confirm={`Delete ${season.short_label}? It has no games.`}>Delete season</button>
      )}
    </div>
  </form>

  <div class="section-head"><span class="pill">🧢 Teams</span></div>

  {teams.length === 0 ? (
    <p class="muted">No teams yet. Add the first one below.</p>
  ) : (
    <form class="card block" method="post" action={`/api/admin/seasons/${slug}`}>
      <p class="muted" style="margin:0">Drag isn't needed — the order here is the order shown when records are tied.</p>
      <div class="table-scroll">
        <table class="grid teams">
          <thead>
            <tr><th>Name</th><th>Address</th><th>Colour</th><th>Home stadium</th><th>Captain</th><th>Roster</th><th></th></tr>
          </thead>
          <tbody>
            {teams.map((t) => {
              const drafted = rosterByTeam.get(Number(t.id)) ?? [];
              return (
                <tr>
                  <td><input type="hidden" name="teamId" value={Number(t.id)} />
                      <input name={`name-${t.id}`} value={String(t.name)} required /></td>
                  <td><input class="narrow" name={`slug-${t.id}`} value={String(t.slug)} /></td>
                  <td><input type="color" name={`color-${t.id}`} value={String(t.color)} /></td>
                  <td>
                    <select name={`stadium-${t.id}`}>
                      <option value="">— none —</option>
                      {stadiumEntries.map(([id, name]) => (
                        <option value={id} selected={String(t.stadium_id) === id}>{name}</option>
                      ))}
                    </select>
                  </td>
                  <td>
                    <select name={`captain-${t.id}`}>
                      <option value="">— none —</option>
                      {drafted.map((c) => (
                        <option value={c} selected={Number(t.captain_char_id) === c}>{CHARACTERS[c]}</option>
                      ))}
                    </select>
                  </td>
                  <td class="mono-num">
                    <a href={`/admin/seasons/${slug}/roster/${t.id}`}
                       class={Number(t.drafted) === 9 ? 'ok' : 'todo'}>{t.drafted}/9 →</a>
                  </td>
                  <td>
                    {/* The button carries the id itself: a submit button sends only its
                        own name/value, so this needs no hidden field and cannot pick the
                        wrong row. */}
                    <button class="linkish danger" type="submit" name="removeTeam" value={Number(t.id)}
                            formnovalidate data-confirm={`Remove ${t.name}? This cannot be undone.`}>remove</button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <button class="btn" type="submit" name="_action" value="save-teams">Save teams</button>
    </form>
  )}

  <form class="card block" method="post" action={`/api/admin/seasons/${slug}`}>
    <div class="row">
      <label class="f grow"><span class="lbl">Add a team</span>
        <input name="teamName" placeholder="e.g. Flame Imp" required /></label>
      <button class="btn" type="submit" name="_action" value="add-team">Add team</button>
    </div>
  </form>

  <div class="section-head"><span class="pill">🗓 Schedule</span></div>
  <p class="muted">
    {roundCount > 0
      ? `${roundCount} rounds set up.`
      : 'No schedule yet — generate one once every team has a roster.'}
  </p>
  <p><a class="btn ghost" href={`/admin/seasons/${slug}/schedule`}>Open the schedule editor →</a></p>
</Admin>

<style>
  .steps { display: flex; gap: 1.2rem; list-style: none; padding: 0; margin: 0 0 1rem; flex-wrap: wrap; }
  .steps li { display: flex; align-items: center; gap: .45rem; font-weight: 600; color: var(--ink-soft); }
  .steps li.done { color: var(--ink); }
  .steps .n { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line); font-size: .75rem; }
  .steps li.done .n { background: var(--grass); border-color: var(--grass); color: #fff; }
  input, select { font: inherit; font-size: .88rem; border: 2px solid var(--line); border-radius: 8px; padding: .28rem .4rem; background: var(--card); color: inherit; }
  input[type=color] { padding: 0; width: 44px; height: 30px; }
  .narrow { width: 120px; }
  .teams td, .teams th { padding: .4rem .45rem; }
  .teams td:first-child, .teams th:first-child { padding-left: 1rem; }
  .check { display: flex; gap: .6rem; align-items: flex-start; margin: .2rem 0 .1rem; max-width: 62ch; }
  .check input { margin-top: .2rem; }
  .check span { display: block; }
  .check .muted { font-size: .82rem; font-weight: 400; }
  .ok { color: var(--grass); font-weight: 700; text-decoration: none; }
  .todo { color: var(--dirt); font-weight: 700; text-decoration: none; }
</style>

